modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3001

[[ports]]
localPort = 8083
externalPort = 3003

[[ports]]
localPort = 18115
externalPort = 3000

[[ports]]
localPort = 18116
externalPort = 3002

[userenv]

[userenv.shared]
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN = "studyhub-39294.firebaseapp.com"
EXPO_PUBLIC_FIREBASE_PROJECT_ID = "studyhub-39294"
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET = "studyhub-39294.firebasestorage.app"
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID = "630073163973"
EXPO_PUBLIC_FIREBASE_APP_ID = "1:630073163973:web:6b2f651b86429b693070ac"
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME = "dku3hlhec"
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET = "rnn9up4k"
